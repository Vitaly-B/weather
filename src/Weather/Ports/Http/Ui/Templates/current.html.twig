{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('weather_current') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('weather_current') }}
{% endblock %}


{% block title %}Weather!{% endblock %}

{% block header %}
    <div>
        <h3 class="float-md-start mb-0">Weather</h3>
    </div>
{% endblock %}

{% block body %}
    <div class="m-auto w-50">
        <h1>Current Weather</h1>

        {{ form_start(form) }}
        {{ form_row(form.city, {
            'attr': {'class': 'form-control'},
            'label_attr': {'class': 'form-label'}
        }) }}
        {{ form_end(form) }}

        <div id="weather-info" class="mt-3"></div>

    </div>
{% endblock %}

{% block footer %}
    <p>Weather</p>
{% endblock %}